{
  "info": {
    "name": "FarmBridge AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newcust\",\n  \"email\": \"newcust@example.com\",\n  \"password\": \"Str0ng!Pass#1\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Register as admin (must be 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"evil\",\n  \"email\": \"evil@example.com\",\n  \"password\": \"Str0ng!Pass#1\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer_demo\",\n  \"password\": \"Demo@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"access\", pm.response.json().access);",
                  "pm.collectionVariables.set(\"refresh\", pm.response.json().refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/auth/me/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/auth/logout/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Shop",
      "item": [
        {
          "name": "Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/products/?search=tomato&available=true"
          }
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/cart/items/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": \"2\"\n}"
            }
          }
        },
        {
          "name": "Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/cart/"
          }
        },
        {
          "name": "Checkout (cash on delivery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/orders/checkout/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_address\": \"12 MG Road, Visakhapatnam\",\n  \"shipping_phone\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/orders/"
          }
        },
        {
          "name": "Order tracking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/orders/1/"
          }
        }
      ]
    },
    {
      "name": "Farmer (login as farmer_ravi first)",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/farmer/dashboard/"
          }
        },
        {
          "name": "My shipments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/farmer/shipments/"
          }
        },
        {
          "name": "Update shipment status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/farmer/shipments/1/status/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processing\",\n  \"note\": \"Packing now\"\n}"
            }
          }
        },
        {
          "name": "Demand prediction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/ai/demand-prediction/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1\n}"
            }
          }
        },
        {
          "name": "Price recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/ai/price-recommendation/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"grade\": \"A\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin (login as admin_demo first)",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/admin/stats/"
          }
        },
        {
          "name": "Pending KYC",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/admin/kyc-applications/?status=pending"
          }
        },
        {
          "name": "Reject KYC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{base}}/admin/kyc-applications/1/reject/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Document is unreadable\"\n}"
            }
          }
        }
      ]
    }
  ]
}